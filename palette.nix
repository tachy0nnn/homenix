# single source of truth for colors. values are bare hex; add # where a format needs it.
{
  bg = "1a1625"; # main background: waybar, swaybg, fuzzel
  bg-overlay = "14101c"; # niri overview backdrop
  bg-lock = "2a2438"; # swaylock inside color
  bg-selection = "2f2840"; # fuzzel selection
  border-inactive = "3a3347"; # niri inactive window border
  fg = "cac4d0"; # waybar text
  fg-muted = "6e6780"; # inactive workspaces
  fg-bright = "e6d9f0"; # clock, selected text
  accent = "d98cb3"; # focus ring, borders, active workspace
  accent-alt = "9d86c9"; # swaylock key highlight
  mako-bg = "2B2930"; # notifications keep their own palette, values unchanged
  mako-fg = "E6E0E9";
}
